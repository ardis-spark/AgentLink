# AgentLink companion — development configuration.
# Copy this file to ".env" (which is git-ignored) and fill in your own values.
# Never commit a real key.

# Your Gemini API key (Google AI Studio → API keys). Optional: you can instead
# enter it on the companion settings page, where it is saved outside the
# repository. A key saved on the settings page takes precedence over this one.
GEMINI_API_KEY=

# Coordinator model. Leave empty to use the default (gemini-4-hydrogen), or
# choose it on the settings page. A model saved there takes precedence.
GEMINI_MODEL=

# Port for the local companion service (loopback only). Default: 47821
AGENTLINK_PORT=

# Where project memory, settings and the saved key are kept. Default: ~/.agentlink
AGENTLINK_HOME=

# Log verbosity: debug | info | warn | error. Default: info
AGENTLINK_LOG_LEVEL=
